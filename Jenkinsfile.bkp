
pipeline {
    agent {
        node {
            label 'ROBOSHOP'
        }
    }

    environment {
        ACC_ID = "209115427888"
        PROJECT = "roboshop"
        COMPONENT = "catalogue"
        APP_VERSION = ""
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {

        stage('Read Version') {
            steps {
                script {
                    def config = readJSON file: 'package.json'
                    env.APP_VERSION = config.version.toString()

                    echo "The application version is: ${env.APP_VERSION}"
                }
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh "${tool 'sonar-8'}/bin/sonar-scanner"
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()

                        if (qg.status != 'OK') {
                            error "Pipeline aborted: ${qg.status}"
                        }

                        echo "SonarQube Quality Gate: ${qg.status}"
                    }
                }
            }
        }

        stage('Check Dependabot Alerts') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        REPO="sivajanardhan9989/Cataloguee"

                        echo "Checking Dependabot alerts for ${REPO}"

                        if ! HTTP_STATUS=$(curl -sS -L \
                            -w '%{http_code}' \
                            -o alerts.json \
                            -H "Accept: application/vnd.github+json" \
                            -H "Authorization: Bearer ${GH_TOKEN}" \
                            -H "X-GitHub-Api-Version: 2022-11-28" \
                            "https://api.github.com/repos/${REPO}/dependabot/alerts?state=open&per_page=100"); then

                            echo "ERROR: Failed to connect to GitHub API."
                            exit 1
                        fi

                        if [ "$HTTP_STATUS" != "200" ]; then
                            echo "ERROR: GitHub API returned HTTP ${HTTP_STATUS}"
                            cat alerts.json
                            exit 1
                        fi

                        if ! jq -e 'type == "array"' alerts.json > /dev/null; then
                            echo "ERROR: Unexpected GitHub API response."
                            exit 1
                        fi

                        echo "---- Open Dependabot Alerts ----"

                        jq -r '
                            if length == 0 then
                                "No open Dependabot alerts found."
                            else
                                .[] |
                                [
                                    .number,
                                    .security_vulnerability.severity,
                                    .dependency.package.name,
                                    .security_advisory.ghsa_id
                                ] | @tsv
                            end
                        ' alerts.json

                        HIGH_CRITICAL_COUNT=$(jq '
                            [
                                .[] |
                                select(
                                    .security_vulnerability.severity == "high"
                                    or
                                    .security_vulnerability.severity == "critical"
                                )
                            ] | length
                        ' alerts.json)

                        echo "High/Critical alert count: ${HIGH_CRITICAL_COUNT}"

                        if [ "$HIGH_CRITICAL_COUNT" -gt 0 ]; then
                            echo "ERROR: Found ${HIGH_CRITICAL_COUNT} High/Critical Dependabot alert(s)."
                            exit 1
                        else
                            echo "SUCCESS: No High/Critical Dependabot alerts found."
                        fi
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    withAWS(
                        credentials: 'aws-creds',
                        region: 'us-east-1'
                    ) {
                        sh '''
                            set -eu

                            IMAGE="${ACC_ID}.dkr.ecr.us-east-1.amazonaws.com/${PROJECT}/${COMPONENT}:${APP_VERSION}"

                            aws ecr get-login-password --region us-east-1 |
                                docker login \
                                    --username AWS \
                                    --password-stdin \
                                    "${ACC_ID}.dkr.ecr.us-east-1.amazonaws.com"

                            docker build -t "${IMAGE}" .
                        '''
                    }
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                script {
                    def image = "${env.ACC_ID}.dkr.ecr.us-east-1.amazonaws.com/${env.PROJECT}/${env.COMPONENT}:${env.APP_VERSION}"

                    echo "Scanning Dockerfile configuration..."

                    def dockerfileScan = sh(
                        script: 'trivy config --exit-code 1 --severity HIGH,CRITICAL --format table ./Dockerfile',
                        returnStatus: true
                    )

                    echo "Scanning Docker image OS packages: ${image}"

                    def imageScan = sh(
                        script: "trivy image --scanners vuln --pkg-types os --exit-code 1 --severity HIGH,CRITICAL --format table \"${image}\"",
                        returnStatus: true
                    )

                    if (dockerfileScan != 0 || imageScan != 0) {
                        error 'Trivy found HIGH/CRITICAL issues in Dockerfile configuration and/or OS packages. Failing pipeline.'
                    }

                    echo 'Trivy scans passed successfully.'
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    withAWS(
                        credentials: 'aws-creds',
                        region: 'us-east-1'
                    ) {
                        sh '''
                            set -eu

                            IMAGE="${ACC_ID}.dkr.ecr.us-east-1.amazonaws.com/${PROJECT}/${COMPONENT}:${APP_VERSION}"

                            docker push "${IMAGE}"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Console Output.'
        }
    }

}
